# Hostinger (LiteSpeed/Apache) config. Copied into the `hostinger` branch by .github/workflows/hostinger.yml.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# The web folder is a git checkout: never serve git metadata or repo dotfiles.
RedirectMatch 404 /\.git
<FilesMatch "^\.(nojekyll|gitignore|gitattributes)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Old Laravel URLs no longer exist; send them home.
  RewriteRule ^(login|register|dashboard|settings|forgot-password|portfolio-template)(/.*)?$ / [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Built assets have content hashes in their names, so they can be cached for a year.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
