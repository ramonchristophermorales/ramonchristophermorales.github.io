---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="panel" data-reveal>
      <span class="eyebrow">Contact</span>
      <h2 id="contact-title">Have a project in mind? <span class="serif">Let’s talk.</span></h2>
      <p>
        I’m available for freelance work and remote roles. Tell me what you’re building and where you need help.
      </p>

      <div class="actions">
        <a class="btn btn-primary big" href={`mailto:${profile.email}`}>
          <Icon name="mail" /> {profile.email}
        </a>
        <button class="btn copy" type="button" data-copy={profile.email}>
          <span class="when-idle"><Icon name="copy" /> Copy email</span>
          <span class="when-done"><Icon name="check" /> Copied</span>
        </button>
      </div>

      <ul class="links">
        <li>
          <a href={profile.links.linkedin} target="_blank" rel="noopener"
            ><Icon name="linkedin" /> LinkedIn <Icon name="arrow-up-right" size={14} /></a
          >
        </li>
        <li>
          <a href={profile.links.github} target="_blank" rel="noopener"
            ><Icon name="github" /> GitHub <Icon name="arrow-up-right" size={14} /></a
          >
        </li>
        <li>
          <a href={profile.links.resume} target="_blank" rel="noopener"
            ><Icon name="file" /> Résumé <Icon name="arrow-up-right" size={14} /></a
          >
        </li>
      </ul>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container inner">
    <p>© {year} {profile.name}</p>
    <p>Built with Astro · <a href="#top">Back to top ↑</a></p>
  </div>
</footer>

<style>
  .panel {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 20px;
    padding: clamp(32px, 6vw, 72px);
    border-radius: 28px;
    background: var(--fg);
    color: var(--bg);
    overflow: hidden;
    isolation: isolate;
  }
  .panel::before {
    content: '';
    position: absolute;
    inset: auto -20% -60% 30%;
    height: 120%;
    z-index: -1;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--accent) 55%, transparent), transparent);
    opacity: 0.6;
  }
  .eyebrow {
    color: color-mix(in oklab, var(--bg) 65%, transparent);
  }
  h2 {
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    max-width: 820px;
  }
  .serif {
    font-style: italic;
  }
  p {
    max-width: 560px;
    font-size: 1.0625rem;
    color: color-mix(in oklab, var(--bg) 72%, transparent);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
    max-width: 100%;
  }
  .btn {
    border-color: color-mix(in oklab, var(--bg) 25%, transparent);
    background: transparent;
    color: var(--bg);
  }
  .btn:hover {
    border-color: color-mix(in oklab, var(--bg) 55%, transparent);
  }
  .btn-primary {
    background: var(--bg);
    color: var(--fg);
    border-color: var(--bg);
  }
  .btn-primary:hover {
    border-color: var(--bg);
  }
  .big {
    height: 52px;
    padding-inline: 24px;
    font-size: 1rem;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .copy {
    height: 52px;
  }
  .copy span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .when-done {
    display: none !important;
  }
  .copy:global(.is-done) .when-idle {
    display: none !important;
  }
  .copy:global(.is-done) .when-done {
    display: inline-flex !important;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 16px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: color-mix(in oklab, var(--bg) 80%, transparent);
    font-weight: 500;
    transition: color 0.2s;
  }
  .links a:hover {
    color: var(--bg);
  }

  .footer {
    padding: 32px 0 48px;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.875rem;
    color: var(--fg-subtle);
  }
  .footer a:hover {
    color: var(--fg);
  }
  @media (max-width: 520px) {
    .big {
      font-size: 0.875rem;
      padding-inline: 18px;
    }
  }
</style>
