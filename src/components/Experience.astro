---
import Icon from './Icon.astro';
import { profile, experience, education } from '../data/profile';
---

<section class="section alt" id="experience" aria-labelledby="exp-title">
  <div class="container grid">
    <div class="about">
      <div class="section-head" data-reveal>
        <span class="eyebrow"><span class="num">02</span> Experience</span>
        <h2 id="exp-title">Ten years of <span class="grad">shipping &amp; leading</span></h2>
      </div>
      <div class="about-copy" data-reveal>
        {profile.about.map((para) => <p>{para}</p>)}
      </div>

      <div class="edu" data-reveal>
        <h3><Icon name="cap" size={16} /> Education</h3>
        <ul>
          {
            education.map((e) => (
              <li>
                <strong>{e.degree}</strong>
                <span>
                  {e.school} · {e.date}
                  {e.note && <> · {e.note}</>}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <ol class="timeline">
      {
        experience.map((job, i) => (
          <li data-reveal style={`--delay: ${i * 60}ms`}>
            <div class="when">{job.date}</div>
            <div class="what">
              <h3>{job.position}</h3>
              <p class="where">
                {job.company} <span>· {job.place}</span>
              </p>
              <p class="desc">{job.description}</p>
              <ul class="tags">
                {job.skills.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .alt {
    background: var(--bg-sunken);
    border-block: 1px solid var(--border);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 7vw, 96px);
  }
  .about {
    align-self: start;
    position: sticky;
    top: 100px;
  }
  .about .section-head {
    margin-bottom: 28px;
  }
  .about-copy {
    display: grid;
    gap: 16px;
    color: var(--fg-muted);
    font-size: 1.0625rem;
  }
  .edu {
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .edu h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    margin-bottom: 16px;
  }
  .edu ul {
    display: grid;
    gap: 14px;
  }
  .edu li {
    display: grid;
    gap: 2px;
  }
  .edu strong {
    font-weight: 600;
  }
  .edu span {
    color: var(--fg-muted);
    font-size: 0.9rem;
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--border);
  }
  .timeline > li {
    position: relative;
    padding: 0 0 48px 32px;
  }
  .timeline > li:last-child {
    padding-bottom: 0;
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 6px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg-elev);
    border: 2px solid var(--fg-subtle);
  }
  .timeline > li:first-child::before {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }
  .when {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--fg-subtle);
    font-variant-numeric: tabular-nums;
    margin-bottom: 8px;
  }
  .what h3 {
    font-size: 1.375rem;
  }
  .where {
    margin-top: 4px;
    font-weight: 500;
  }
  .where span {
    color: var(--fg-subtle);
    font-weight: 400;
  }
  .desc {
    margin-top: 12px;
    color: var(--fg-muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .about {
      position: static;
    }
  }
</style>
