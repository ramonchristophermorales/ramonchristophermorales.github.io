---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const nav = [
  { href: '#work', label: 'Work' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#testimonials', label: 'Testimonials' },
];
---

<header class="header" data-header>
  <div class="container inner">
    <a href="#top" class="brand" aria-label={`${profile.name}, back to top`}>
      <span class="mark" aria-hidden="true">R</span>
      <span class="brand-name">{profile.name}</span>
    </a>

    <nav aria-label="Primary" class="nav">
      <ul>
        {nav.map((item) => <li><a href={item.href} data-nav>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle dark mode">
        <Icon name="sun" class="sun" />
        <Icon name="moon" class="moon" />
      </button>
      <a href="#contact" class="btn btn-primary cta">Let’s talk</a>
      <button class="icon-btn menu-btn" type="button" popovertarget="mobile-nav" aria-label="Open menu">
        <span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" popover class="mobile-nav">
    <ul>
      {nav.map((item) => <li><a href={item.href} data-close-menu>{item.label}</a></li>)}
      <li><a href="#contact" data-close-menu>Contact</a></li>
    </ul>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    transition:
      background-color 0.3s,
      border-color 0.3s,
      backdrop-filter 0.3s;
    border-bottom: 1px solid transparent;
  }
  .header:global(.is-scrolled) {
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom-color: var(--border);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    min-width: 0;
  }
  .brand-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: linear-gradient(135deg, #4f46e5, #0891b2);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      0 2px 8px -2px rgb(79 70 229 / 0.5);
  }
  .nav ul {
    display: flex;
    gap: 4px;
  }
  .nav a {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--fg-muted);
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .nav a:hover,
  .nav a:global(.is-active) {
    color: var(--fg);
    background: var(--bg-muted);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cta {
    height: 40px;
    padding-inline: 18px;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--fg-muted);
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .icon-btn:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }
  .icon-btn :global(.moon) {
    display: none;
  }
  :global([data-theme='dark']) .icon-btn :global(.sun) {
    display: none;
  }
  :global([data-theme='dark']) .icon-btn :global(.moon) {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-btn :global(.sun) {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .icon-btn :global(.moon) {
      display: block;
    }
  }

  .menu-btn {
    display: none;
  }
  .bars,
  .bars::before {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
  }
  .bars {
    position: relative;
    transform: translateY(-3px);
  }
  .bars::before {
    content: '';
    position: absolute;
    top: 6px;
  }

  .mobile-nav {
    inset: 76px var(--gutter) auto auto;
    margin: 0;
    padding: 8px;
    min-width: 200px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    color: var(--fg);
    box-shadow: var(--shadow-lg);
  }
  .mobile-nav a {
    display: block;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }
  .mobile-nav a:hover {
    background: var(--bg-muted);
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }
  @media (max-width: 520px) {
    .brand-name {
      display: none;
    }
    .cta {
      padding-inline: 14px;
    }
  }
</style>
