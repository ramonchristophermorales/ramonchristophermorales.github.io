---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import portrait from '../assets/img/portrait.png';
import { profile } from '../data/profile';
---

<section class="hero" id="top">
  <div class="backdrop" aria-hidden="true"></div>
  <div class="container grid">
    <div class="copy">
      <p class="status" data-reveal>
        <span class="dot" aria-hidden="true"></span>
        {profile.availability}
      </p>
      <h1 data-reveal style="--delay: 60ms">
        Full-stack developer building <span class="grad">reliable web platforms</span>
      </h1>
      <p class="lede" data-reveal style="--delay: 120ms">{profile.intro}</p>
      <div class="ctas" data-reveal style="--delay: 180ms">
        <a href="#work" class="btn btn-primary">
          View selected work <Icon name="arrow-right" />
        </a>
        <div class="socials">
          <a href={profile.links.linkedin} class="btn btn-icon" target="_blank" rel="noopener" aria-label="LinkedIn">
            <Icon name="linkedin" />
          </a>
          <a href={profile.links.github} class="btn btn-icon" target="_blank" rel="noopener" aria-label="GitHub">
            <Icon name="github" />
          </a>
        </div>
      </div>
    </div>

    <div class="visual" data-reveal style="--delay: 120ms">
      <div class="portrait">
        <Image
          src={portrait}
          alt={`Illustrated portrait of ${profile.name}`}
          widths={[360, 540, 720]}
          sizes="(max-width: 900px) 112px, 420px"
          loading="eager"
          fetchpriority="high"
          format="webp"
        />
      </div>
      <div class="float loc">
        <Icon name="pin" size={14} />
        {profile.location}
      </div>

    <div class="editor" aria-hidden="true">
      <div class="editor-bar">
        <span class="lights"><i></i><i></i><i></i></span>
        <span class="file">ramon.ts</span>
      </div>
      <pre data-typewriter><code><span class="ln">1</span><span class="k">const</span> <span class="v">ramon</span> = &#123;
<span class="ln">2</span>  <span class="p">role</span>: <span class="s">'Full-Stack Developer'</span>,
<span class="ln">3</span>  <span class="p">stack</span>: [<span class="s">'Laravel'</span>, <span class="s">'Vue'</span>, <span class="s">'React'</span>, <span class="s">'TS'</span>],
<span class="ln">4</span>  <span class="p">experience</span>: <span class="n">10</span>, <span class="c">// years</span>
<span class="ln">5</span>  <span class="p">available</span>: <span class="n">true</span>,
<span class="ln">6</span>&#125;;
<span class="ln">7</span>
<span class="ln">8</span><span class="v">ramon</span>.<span class="f">build</span>(<span class="s">'your next platform'</span>);</code></pre>
    </div>
    </div>
  </div>

  <div class="container">
    <dl class="stats" data-reveal style="--delay: 240ms">
      {
        profile.stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
      <div>
        <dt>Certified ScrumMaster® &amp; Product Owner</dt>
        <dd>CSM · CSPO</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(48px, 7vw, 96px);
    padding-bottom: clamp(48px, 7vw, 80px);
    isolation: isolate;
    overflow: hidden;
  }
  .backdrop {
    position: absolute;
    inset: -68px 0 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(70% 60% at 50% 30%, #000 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(70% 60% at 50% 30%, #000 40%, transparent 100%);
  }
  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(35% 40% at 80% 35%, color-mix(in oklab, var(--accent) 16%, transparent), transparent 70%),
      radial-gradient(30% 35% at 95% 70%, color-mix(in oklab, var(--accent-2) 12%, transparent), transparent 70%);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 12px 5px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elev);
    box-shadow: var(--shadow);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--fg-muted);
    margin-bottom: 28px;
  }
  .dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
  }
  .dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: #10b981;
    opacity: 0.35;
    animation: pulse 2.4s var(--ease) infinite;
  }
  @keyframes pulse {
    0% {
      transform: scale(0.6);
      opacity: 0.5;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    max-width: 14ch;
  }
  .lede {
    margin-top: 24px;
    max-width: 560px;
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    color: var(--fg-muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 36px;
  }
  .socials {
    display: flex;
    gap: 10px;
  }
  .btn-icon {
    width: 44px;
    padding: 0;
  }

  .visual {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 420px;
  }
  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid var(--border);
    background:
      radial-gradient(80% 60% at 30% 20%, color-mix(in oklab, var(--accent) 30%, transparent), transparent 70%),
      radial-gradient(70% 60% at 90% 90%, color-mix(in oklab, var(--accent-2) 28%, transparent), transparent 70%),
      var(--bg-muted);
    box-shadow: var(--shadow-lg);
  }
  .portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .portrait :global(img) {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 104%;
    max-width: none;
    transform: translateX(-46%);
  }
  .float {
    position: absolute;
    border: 1px solid var(--border);
    background: color-mix(in oklab, var(--bg-elev) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-lg);
    border-radius: 14px;
  }
  /* Mini code editor: always dark, like a real IDE */
  .editor {
    position: absolute;
    left: -88px;
    bottom: -44px;
    z-index: 2;
    width: 380px;
    border-radius: 14px;
    border: 1px solid #26262c;
    background: rgb(13 13 16 / 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow:
      0 24px 48px -16px rgb(0 0 0 / 0.45),
      0 0 0 1px rgb(255 255 255 / 0.03) inset;
    overflow: hidden;
    color: #d4d4d8;
  }
  .editor-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid #1f1f24;
    background: rgb(255 255 255 / 0.02);
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .lights i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3f3f46;
  }
  .lights i:nth-child(1) {
    background: #ff5f57;
  }
  .lights i:nth-child(2) {
    background: #febc2e;
  }
  .lights i:nth-child(3) {
    background: #28c840;
  }
  .file {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #a1a1aa;
  }
  .editor pre {
    margin: 0;
    padding: 14px 16px 16px 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
    white-space: pre;
    overflow: hidden;
  }
  .editor .ln {
    display: inline-block;
    width: 34px;
    padding-right: 14px;
    text-align: right;
    color: #52525b;
    user-select: none;
  }
  .editor .k {
    color: #c084fc;
  }
  .editor .v {
    color: #f4f4f5;
  }
  .editor .p {
    color: #93c5fd;
  }
  .editor .s {
    color: #86efac;
  }
  .editor .n {
    color: #fdba74;
  }
  .editor .c {
    color: #71717a;
    font-style: italic;
  }
  .editor .f {
    color: #67e8f9;
  }
  .editor :global(.caret) {
    display: inline-block;
    width: 7px;
    height: 1.1em;
    margin-left: 1px;
    vertical-align: -0.18em;
    background: #a5b4fc;
    animation: blink 1s steps(1) infinite;
  }
  .editor :global(.caret.is-typing) {
    animation: none;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .loc {
    right: -20px;
    top: 28px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--fg-muted);
    animation: bob 7s ease-in-out -2s infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(-6px);
    }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: clamp(56px, 8vw, 88px) 0 0;
  }
  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--bg-elev) 80%, transparent);
  }
  .stats dd {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .stats dt {
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }

  @media (max-width: 1100px) {
    .editor {
      left: -40px;
      width: 350px;
    }
    .editor pre {
      font-size: 0.72rem;
    }
    .loc {
      right: -8px;
    }
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    /* Portrait becomes a small avatar above the copy; the editor drops below the buttons. */
    .visual {
      display: contents;
    }
    .portrait {
      justify-self: start;
      width: 112px;
      order: -1;
      margin-bottom: -8px;
    }
    .editor {
      position: relative;
      left: auto;
      bottom: auto;
      width: 100%;
      max-width: 460px;
    }
    .editor pre {
      font-size: 0.7rem;
    }
    .editor .ln {
      width: 28px;
      padding-right: 10px;
    }
    .portrait {
      aspect-ratio: 1;
      border-radius: 50%;
      box-shadow: var(--shadow);
    }
    .portrait :global(img) {
      width: 150%;
      transform: translateX(-44%) translateY(30%);
    }
    .float {
      display: none;
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
