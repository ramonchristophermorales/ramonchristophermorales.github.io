---
import Icon from './Icon.astro';
import { achievements } from '../data/game';

const levels = [
  { href: '#quests', id: 'quests', label: 'Quests' },
  { href: '#bughunt', id: 'bughunt', label: 'Bug Hunt' },
  { href: '#career', id: 'career', label: 'Career' },
  { href: '#reviews', id: 'reviews', label: 'Reviews' },
  { href: '#boss', id: 'boss', label: 'Boss' },
];
---

<header class="hud">
  <div class="container inner">
    <a href="#top" class="brand" aria-label="Back to start">
      <span class="mark pixel" aria-hidden="true">R</span>
    </a>

    <div class="board">
      <div class="stat">
        <span class="label pixel">Score</span>
        <span class="val pixel" data-score aria-live="off">000000</span>
      </div>
      <div class="stat rank">
        <span class="label pixel">Rank</span>
        <span class="val name" data-rank>Intern</span>
      </div>
    </div>

    <nav aria-label="Levels" class="levels">
      <ol>
        {
          levels.map((l, i) => (
            <li>
              <a href={l.href} data-nav data-reached={`level:${l.id}`}>
                <span class="n pixel">{i === levels.length - 1 ? '★' : i + 1}</span>
                {l.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="actions">
      <button class="trophies" type="button" data-open="achievements" aria-haspopup="dialog" aria-label="Achievements">
        <Icon name="award" size={16} />
        <span class="pixel" data-ach-count>0/{achievements.length}</span>
      </button>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle dark mode">
        <Icon name="sun" class="sun" />
        <Icon name="moon" class="moon" />
      </button>
    </div>
  </div>
  <div class="meter" data-progress role="progressbar" aria-label="Page explored" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
  </div>
</header>

<dialog id="achievements" class="modal ach-modal" aria-labelledby="achievements-title">
  <header class="modal-head">
    <div>
      <span class="eyebrow">Explored <span data-progress-text>0%</span></span>
      <h3 id="achievements-title">Achievements</h3>
    </div>
    <form method="dialog">
      <button class="close" aria-label="Close"><Icon name="x" /></button>
    </form>
  </header>
  <ul class="ach-list">
    {
      achievements.map((a) => (
        <li data-ach={a.id}>
          <span class="badge" aria-hidden="true">★</span>
          <div>
            <p class="ach-name">{a.name}</p>
            <p class="ach-desc">{a.desc}</p>
          </div>
          <span class="ach-state pixel">
            <span class="locked">Locked</span>
            <span class="got">Unlocked</span>
          </span>
        </li>
      ))
    }
  </ul>
  <footer class="ach-foot">
    <p>Score and achievements are saved in this browser.</p>
    <button type="button" class="btn" data-reset>Reset progress</button>
  </footer>
</dialog>

<style>
  .hud {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 64px;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: linear-gradient(135deg, #4f46e5, #0891b2);
    color: #fff;
    font-size: 0.875rem;
    box-shadow: 3px 3px 0 var(--fg);
  }
  .board {
    display: flex;
    gap: 20px;
  }
  .stat {
    display: grid;
    gap: 4px;
  }
  .label {
    font-size: 0.5rem;
    color: var(--fg-subtle);
  }
  .val {
    font-size: 0.875rem;
    line-height: 1;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .val.name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--accent-text);
  }

  .levels {
    margin-left: auto;
  }
  .levels ol {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .levels a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.875rem;
    color: var(--fg-muted);
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .levels a:hover,
  .levels a:global(.is-active) {
    color: var(--fg);
    background: var(--bg-muted);
  }
  .n {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    font-size: 0.5rem;
    border: 1px solid var(--border-strong);
    color: var(--fg-subtle);
  }
  .levels a:global(.is-done) .n {
    background: var(--good);
    border-color: var(--good);
    color: #fff;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .trophies {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding-inline: 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--gold) 40%, var(--border));
    background: color-mix(in oklab, var(--gold) 10%, var(--bg-elev));
    color: var(--gold);
  }
  .trophies .pixel {
    font-size: 0.5625rem;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--fg-muted);
  }
  .icon-btn:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }
  .icon-btn :global(.moon) {
    display: none;
  }
  :global([data-theme='dark']) .icon-btn :global(.sun) {
    display: none;
  }
  :global([data-theme='dark']) .icon-btn :global(.moon) {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-btn :global(.sun) {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .icon-btn :global(.moon) {
      display: block;
    }
  }

  .meter {
    --p: 0%;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2)) no-repeat 0 0 / var(--p) 100%;
    transition: background-size 0.6s var(--ease);
  }

  /* Achievements dialog */
  .ach-modal {
    width: min(560px, calc(100% - 32px));
  }
  .ach-list {
    display: grid;
    gap: 8px;
    padding: 16px 24px;
  }
  .ach-list li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 12px;
    border-radius: 12px;
    border: 1px solid var(--border);
    opacity: 0.6;
  }
  .ach-list li:global(.is-unlocked) {
    opacity: 1;
    border-color: color-mix(in oklab, var(--gold) 45%, var(--border));
    background: color-mix(in oklab, var(--gold) 7%, transparent);
  }
  .badge {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--bg-muted);
    color: var(--fg-subtle);
    font-size: 1.125rem;
  }
  li:global(.is-unlocked) .badge {
    background: #fbbf24;
    color: #09090b;
  }
  .ach-name {
    font-weight: 600;
  }
  .ach-desc {
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  .ach-state {
    font-size: 0.5rem;
    color: var(--fg-subtle);
  }
  .ach-state .got,
  li:global(.is-unlocked) .ach-state .locked {
    display: none;
  }
  li:global(.is-unlocked) .ach-state .got {
    display: inline;
    color: var(--gold);
  }
  .ach-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 24px 24px;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  @media (max-width: 1060px) {
    .levels {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
  }
  @media (max-width: 480px) {
    .inner {
      gap: 14px;
    }
    .rank {
      display: none;
    }
    .ach-state {
      display: none;
    }
    .ach-list li {
      grid-template-columns: 40px minmax(0, 1fr);
    }
    .ach-foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
