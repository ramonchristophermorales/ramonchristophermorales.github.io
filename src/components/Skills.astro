---
import Icon from './Icon.astro';
import { skills, certifications } from '../data/profile';
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Toolkit</span>
      <h2 id="skills-title">The stack I <span class="serif">reach for</span></h2>
      <p>Deep in the PHP and JavaScript ecosystems, comfortable across the full stack, and experienced running teams the Scrum way.</p>
    </div>

    <div class="grid">
      {
        skills.map((group, i) => (
          <div class="group" data-reveal style={`--delay: ${i * 60}ms`}>
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="group certs" data-reveal style="--delay: 240ms">
        <h3>Certifications</h3>
        <ul>
          {
            certifications.map((c) => (
              <li>
                <Icon name="award" size={16} /> {c}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .group {
    background: var(--bg);
    padding: 28px 24px 32px;
  }
  .group h3 {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    margin-bottom: 18px;
  }
  .group ul {
    display: grid;
    gap: 10px;
  }
  .group li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
  }
  .certs li {
    font-weight: 400;
    font-size: 0.9375rem;
    align-items: flex-start;
  }
  .certs :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--accent);
  }
</style>
