---
import Base from '../layouts/Base.astro';

const home = import.meta.env.BASE_URL;
---

<Base title="Page not found — Ramon Christopher Morales">
  <main id="main" class="container nf">
    <p class="eyebrow">404</p>
    <h1>This page <span class="grad">wandered off.</span></h1>
    <a class="btn btn-primary" href={home}>Back to the portfolio</a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    justify-items: start;
    gap: 24px;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }
</style>
